# Quix Cloud (dev) connection — copy to ../.env and fill in the tokens.
# Used by local scripts (scripts/*.py) to reach the workspace broker & Portal API.

# SDK token for the TTL test environment.
# Quix Portal -> Settings -> API & Tokens (or environment -> Topics -> Connect).
Quix__Sdk__Token=

# Personal Access Token for Portal API calls (topic clean, swagger, etc.).
Quix__Pat__Token=

# Workspace/environment ID (visible in the Portal URL).
Quix__Workspace__Id=quixdev-ttltestenvironment-ttlgenerator

# Dev portal API.
Quix__Portal__Api=https://portal-api.dev.quix.io
