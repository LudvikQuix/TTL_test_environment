# Quix SDK Token - find this in the Quix Portal under Settings > Tokens (SDK Tokens section)
Quix__Sdk__Token=

# Topic names (from your Quix environment)
output=raw-events

# Upper bound for random order IDs (1..KEY_SPACE)
KEY_SPACE=1000000

# Total number of messages to produce before exiting
MESSAGE_COUNT=600

# Delay between messages in seconds
SLEEP_SECONDS=0.1

# Optional integer seed for deterministic runs (leave blank for random)
# SEED=42
