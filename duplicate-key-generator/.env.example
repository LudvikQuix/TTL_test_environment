# Quix SDK Token - find this in the Quix Portal under Settings > Tokens (SDK Tokens section)
Quix__Sdk__Token=

# Topic names (from your Quix environment)
output=raw-events

# Upper bound for random order IDs (1..KEY_SPACE)
KEY_SPACE=1000000

# Total messages to produce. 0 = run forever (Service mode)
MESSAGE_COUNT=0

# Delay between messages in seconds (0.01 = ~100 msg/s)
SLEEP_SECONDS=0.01

# Optional integer seed for deterministic runs
# SEED=42
