# Quix SDK Token - find this in the Quix Portal under Settings > Tokens (SDK Tokens section)
Quix__Sdk__Token=

# Topic names (from your Quix environment)
input=recovery-input
output=recovery-output

# Maps to Application(auto_recover_from_source_offset_out_of_range=...)
# true = destroy + rebuild state when committed offset < low watermark
# false = raise StateRecoveryOffsetOutOfRange
AUTO_RECOVER=true

# Maps to Application(state_recovery_offset_reset=...): earliest | latest | match
OFFSET_RESET=earliest

# Local directory for RocksDB state
STATE_DIR=state

# Seconds between [STATE-SIZE-RECOVERY] log lines
STATE_SIZE_LOG_INTERVAL=10
