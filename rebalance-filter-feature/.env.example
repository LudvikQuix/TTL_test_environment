# Quix SDK Token - Quix Portal > Settings > Tokens (SDK Tokens). Used for local runs.
Quix__Sdk__Token=

# Topics (from your Quix environment)
input=rebalance-raw-events
output=rebalance-feature-out

# State namespace (consumer group). Bump CG_VERSION for a fresh store.
CG_PREFIX=rebalance-filter-feature
CG_VERSION=v1

# Write-heavy state pressure + low poll interval (see main.py docstring).
VALUE_PADDING_BYTES=2000
MAX_POLL_INTERVAL_MS=60000
ROCKSDB_WRITE_BUFFER_SIZE=1048576
ROCKSDB_TARGET_FILE_SIZE_BASE=2097152
ROCKSDB_MAX_WRITE_BUFFER_NUMBER=2
STATE_SIZE_LOG_INTERVAL=5
LOGGER=on

# DEBUG is required to observe the fast-revoke / benign-close markers.
QS_LOGLEVEL=DEBUG
