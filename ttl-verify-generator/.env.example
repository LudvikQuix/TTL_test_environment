# Quix SDK Token - find this in the Quix Portal under Settings > Tokens (SDK Tokens section)
Quix__Sdk__Token=

# Output topic both dedupers read from
output=ttl-verify-input

# Number of unique keys per batch
KEY_COUNT=3
# Seconds to wait between batch 1 and batch 2
WAIT_SECONDS=10
# Status field value (same for both batches so dedup logic sees a "duplicate")
STATUS=ON
