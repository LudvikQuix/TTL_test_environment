# -----------------------------------------------------------------------------
# Defaults for the local docker E2E TTL-migration harness.
#
# Single source of truth for topic / TTL / sizing knobs. The host runner
# (runner/run.py) parses this file, uses the runner-only knobs itself (SEED_N,
# KILL_AFTER_CHUNKS, ...), and passes the app-relevant vars into each
# app/seeder/inspector container. Per-phase overrides (TTL_MODE, CG_VERSION,
# QUIXSTREAMS_STATE_LOG_LEVEL, ...) are applied by the runner on top of these.
#
# See spec.md sections 7.1 (per-phase env) and 8 (sizing defaults).
# -----------------------------------------------------------------------------

# ---- Broker (in-container DNS name of the compose kafka service) ----
BROKER_ADDRESS=kafka:9092

# ---- App topics (shared source/output; deleted+recreated per scenario) ----
input=raw-events
output=deduped-events

# ---- Consumer group. CG_VERSION is set per-scenario by the runner (v_a/v_b/v_c)
CG_PREFIX=dedup-filter

# ---- State (relative to WORKDIR /app -> /app/state, the named volume) ----
STATE_DIR=state

# ---- TTL windows: long (2h) so nothing expires mid-run (zero-drops by
#      key-count invariance, not by clock fast-forward) ----
STATE_TTL_SECONDS=7200
LEGACY_RECORDS_TTL_SECONDS=7200

# ---- Backfill kill lever: 50 over SEED_N=5000 -> ~100 chunks -> wide window ----
LEGACY_BACKFILL_CHUNK_SIZE=50

# ---- Value size (matches the manual runs) ----
VALUE_PADDING_BYTES=800

# ---- Logging. Periodic [STATE-SIZE-STABLE] every N s = cheap liveness signal.
LOGGER=on
STATE_SIZE_LOG_INTERVAL=3

# ============================================================================
# Runner-only knobs (NOT read by the app; consumed by runner/run.py).
# ============================================================================
# Distinct order_ids to seed as legacy (unstamped) keys.
SEED_N=5000
# Trigger messages (status-flip of the first M seed keys) -> fire the backfill
# WITHOUT adding keys, so post-migration count stays exactly SEED_N.
TRIGGER_M=5
# Kill on the Kth per-chunk DEBUG progress line after STARTED (~K*chunk stamped).
KILL_AFTER_CHUNKS=5
# Abort (exit 2) if STARTED is not seen within this many seconds, or if
# FINISHED appears before the Kth progress line (kill window missed).
KILL_TIMEOUT_S=90
# Max seconds to wait for the seed store to reach SEED_N persisted keys.
SEED_TIMEOUT_S=180
# Max seconds to wait for a migrate/restart terminal log line.
PHASE_TIMEOUT_S=180
