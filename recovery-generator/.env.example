# Quix SDK Token - find this in the Quix Portal under Settings > Tokens (SDK Tokens section)
Quix__Sdk__Token=

# Output topic (created by the app with segment.ms=60000 / retention.ms=120000)
output=recovery-input

# Messages per second (sleep-paced)
RATE_PER_SECOND=100

# Bytes of 'x' padding per message
PADDING_BYTES=200

# Key space size; keys are key-{seq % KEY_COUNT}
KEY_COUNT=1000
